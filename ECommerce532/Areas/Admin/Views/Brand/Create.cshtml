<div class="container">
    <div class="row"><div class="display-6 my-4">Create New Brand</div></div>
    <div class="row">
        @* <form action="/Admin/Brand/Create"> *@
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="Name" class="form-label">Name</label>
                <input type="text" class="form-control" id="Name" name="Name" aria-describedby="Name">
            </div>
            <div class="mb-3">
                <label for="Img" class="form-label">Upload Img</label>
                <input class="form-control" type="file" name="Img" id="Img" accept="image/*">
            </div>
            <div class="mb-3">
                <label for="Status" class="form-label">Status</label>
                <select name="Status" class="form-select" aria-label="Status">
                    <option value="true">Active</option>
                    <option value="false">In Active</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>