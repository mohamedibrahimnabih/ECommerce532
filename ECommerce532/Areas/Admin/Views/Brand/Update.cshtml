@model Category

<div class="container">
    <div class="row"><div class="display-6 my-4">Update Category</div></div>
    <div class="row">
        @* <form action="/Admin/Category/Update"> *@
        <form method="post">
            @* <input type="hidden" name="Id" value="@Model.Id" /> *@
            <div class="mb-3">
                <label for="Name" class="form-label">Name</label>
                <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" aria-describedby="Name">
            </div>
            <div class="mb-3">
                <label for="Description" class="form-label">Description</label>
                <div class="form-floating">
                    <textarea class="form-control" name="Description" placeholder="Leave a description here" id="Description">@Model.Description</textarea>
                    <label for="Description">Leave a description here</label>
                </div>
            </div>
            <div class="mb-3">
                <label for="Status" class="form-label">Status</label>
                <select name="Status" class="form-select" aria-label="Status">
                    @if(Model.Status)
                    {
                        <option value="true" selected>Active</option>
                        <option value="false">In Active</option>
                    }
                    else
                    {
                        <option value="true">Active</option>
                        <option value="false" selected>In Active</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>