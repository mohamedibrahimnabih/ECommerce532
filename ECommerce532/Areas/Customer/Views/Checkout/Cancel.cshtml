@{
    ViewData["Title"] = "Payment Cancelled";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-sm border-0 text-center p-4" style="max-width: 500px; width: 100%;">
        <div class="card-body">
            <div class="mb-3">
                <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
            </div>

            <h3 class="card-title fw-bold mb-2">Payment Cancelled</h3>
            <p class="text-muted mb-4">
                Your payment was not completed and your order has not been placed.
                No charges were made. You can review your cart and try again anytime.
            </p>

            @if (ViewData["OrderId"] != null)
            {
                <p class="mb-4">
                    <span class="text-muted">Order ID:</span>
                    <strong>#@ViewData["OrderId"]</strong>
                </p>
            }

            <div class="d-grid gap-2">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-danger">
                    Back to Cart
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>